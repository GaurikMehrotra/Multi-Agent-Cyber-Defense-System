FROM python:3.12-slim@sha256:a6e34c598f2467ed0e9a8d349809fcd8b5c603269512df273a0bb1784edc11b1
RUN --mount=type=secret,id=proxy_ca,mode=0444 \
    sed -i 's|http://deb.debian.org|https://deb.debian.org|g' /etc/apt/sources.list.d/debian.sources && \
    if [ -s /run/secrets/proxy_ca ]; then export SSL_CERT_FILE=/run/secrets/proxy_ca; apt_opt='-o Acquire::https::CaInfo=/run/secrets/proxy_ca'; else apt_opt=''; fi && \
    apt-get $apt_opt update && apt-get $apt_opt install -y --no-install-recommends nmap=7.95+dfsg-3 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY requirements-tools.txt .
RUN --mount=type=secret,id=proxy_ca,mode=0444 \
    if [ -s /run/secrets/proxy_ca ]; then export SSL_CERT_FILE=/run/secrets/proxy_ca REQUESTS_CA_BUNDLE=/run/secrets/proxy_ca; fi; \
    pip install --no-cache-dir --upgrade pip==26.2.1 && pip install --no-cache-dir -r requirements-tools.txt
COPY src src
COPY configs configs
RUN useradd --uid 10001 --create-home scanner && mkdir runtime && chown scanner:scanner runtime
RUN chmod -R a+rX /app/src /app/configs
USER 10001:10001
ENTRYPOINT ["python", "-m", "src.tools.verification_server"]
